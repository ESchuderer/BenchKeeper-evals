{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "includes": ["**/*.{js,jsx,ts,tsx,mjs,cjs}", "!**/node_modules", "!**/dist", "!**/build", "!**/.next", "!**/coverage", "!**/*.min.js"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "warn", "noConsole": "off" },
      "style": { "useConst": "warn" },
      "correctness": { "noUnusedVariables": "warn", "noUnusedImports": "warn" }
    }
  }
}
